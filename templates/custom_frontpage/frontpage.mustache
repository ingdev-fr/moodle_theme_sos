{{!
    @template theme_boost/columns1

    Boost 1 column layout template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
         "bodyattributes":""
    }
}}

{{! Création du template de la page d'accueil via le template de boost "columns1" }}

{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

{{!  Calque coloré du haut de page 
<div class="layer-top position-absolute translate-middle-x overflow-hidden">
    <div class="shape-1 gradient-top"></div>
</div> }}

{{! Calque coloré du bas de page 
<div class="layer-bottom position-absolute overflow-hidden">
    <div class="shape-2 gradient-bottom"></div>
</div> }}

<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid d-print-block mt-0">
        <div id="page-content" class="d-print-block mb-0 pb-0">
            <div id="region-main-box" class="">
                <div id="region-main" aria-label="{{#str}}content{{/str}}">
                    <div class="homepage">
                        {{> theme_theme_sos/custom_frontpage/includes/hero-section }}
                        {{> theme_theme_sos/custom_frontpage/includes/features-section }}
                        {{> theme_theme_sos/custom_frontpage/includes/marketing-section }}
                    </div>
                    {{! Ne contient rien comme contenu de page généré par Moodle}}
                    {{{ output.main_content }}}

                </div>
            </div>
        {{> theme_theme_sos/custom_frontpage/includes/theme_sos_footer }}  
        </div>
    </div>
    {{{ output.standard_after_main_region_html }}}

</div>


{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
