{{!

    @template theme_boost/navbar

    This template renders the top navbar.


}}

{{! Custom dut template boost de la navbar pour la front page custom : avec classe frontnavbar. La nav est restylée pour le front.}}
{{! Modifications par rapport au modèle original :
    * Ajout d'une classe personnalisée "frontnavbar" à la barre de navigation pour des besoins de style.
    * Ajout d'un logo et d'un titre personnalisés pour la barre de navigation.
    * Suppression du bouton de basculement de la barre de navigation par défaut pour la vue mobile.
    * Ajustement de la mise en page et des styles pour un meilleur alignement et espacement.
}}

<nav class="navbar frontnavbar navbar-expand border-0 px-2 px-lg-5 shadow-none" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid px-2 px-lg-5">
        <a href="{{{ config.homeurl }}}" class="navbar-brandm-0 me-4 p-0 aabtn">
            <img src="{{{logofooterurl}}}" class="logo me-2" alt="{{sitename}}">
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        <ul class="navbar-nav d-none d-md-flex my-1 px-1">
            <!-- page_heading_menu -->
            {{{ output.page_heading_menu }}}
        </ul>

        <div id="usernavigation" class="navbar-nav ms-auto flew-wrap">
            {{# output.search_box }}
            <!-- invisible-->
                {{{ output.search_box }}}
                <div class="divider border-start h-75 align-self-center mx-1 d-none"></div>
            {{/output.search_box}}
            {{#langmenu}}
            <!-- Menu des langues invisible-->
                <div class="d-none">
                    {{> theme_boost/language_menu }}
                </div>
                <div class="divider border-start h-75 align-self-center mx-1 d-none"></div>
            {{/langmenu}}
            {{{ output.navbar_plugin_output }}}
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                    {{> core/user_menu }}
                {{/usermenu}}
            </div>
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>

